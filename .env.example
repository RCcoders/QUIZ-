# Firebase has been removed — no VITE_FIREBASE_* vars required

# ─── Python AI Service (Ollama-based) ────────────────────────────────────────
# URL of the local Python FastAPI server (api.py). Defaults to localhost:8000.
# PYTHON_API_URL=http://localhost:8000

# ─── Ollama (local AI — replaces OpenAI for local dev) ───────────────────────
# Set OLLAMA_BASE_URL to use Ollama instead of OpenAI for all AI agents.
# Run: ollama serve  (starts on http://localhost:11434 by default)
# Pull a model first: ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ─── Gemini AI (SERVER-SIDE ONLY) ─────────────────────────────────────────────
# DO NOT add VITE_ prefix — this would expose the key in the browser bundle.
# Set this in Vercel Dashboard → Project Settings → Environment Variables.
# GEMINI_API_KEY=your_gemini_api_key

# ─── Removed variables ────────────────────────────────────────────────────────
# VITE_SUPABASE_URL — Supabase has been replaced. Remove from .env.
# VITE_SUPABASE_ANON_KEY — Same as above. Remove from .env.
# VITE_GEMINI_API_KEY — Moved server-side. Remove from .env.
