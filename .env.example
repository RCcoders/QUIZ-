# ─── Firebase Configuration (client-safe) ────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Gemini AI (SERVER-SIDE ONLY) ─────────────────────────────────────────────
# DO NOT add VITE_ prefix — this would expose the key in the browser bundle.
# Set this in Vercel Dashboard → Project Settings → Environment Variables.
# GEMINI_API_KEY=your_gemini_api_key

# ─── Removed variables ────────────────────────────────────────────────────────
# VITE_SUPABASE_URL — Supabase has been replaced by Firebase. Remove from .env.
# VITE_SUPABASE_ANON_KEY — Same as above. Remove from .env.
# VITE_GEMINI_API_KEY — Moved server-side. Remove from .env.
